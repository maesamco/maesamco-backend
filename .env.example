# ⚠️ 이 파일은 git에 커밋되는 "템플릿"입니다. 아래 더미값들은 로컬 개발 전용이라
# 공개되어도 안전하지만, ANTHROPIC_API_KEY처럼 "진짜 개인/팀 키"가 필요한 항목은
# 이 파일에 절대 채우지 마세요 — 이 저장소는 Public입니다.
#
# 사용법: cp .env.example .env  (그러면 Gateway·User·Content 등은 대부분 바로 뜹니다)

# ===== DB (로컬 전용 더미 비밀번호 — docker-compose 기본값과 동일) =====
DB_USERNAME=maesamco
DB_PASSWORD=changeme

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== JWT Access Token (RS256) =====
# 아래 키쌍은 Access Token 로컬 개발/부팅 테스트 전용 더미 키입니다.
# 운영 환경에서는 반드시 별도의 운영 키쌍을 사용하고 Secret Manager 등으로 관리합니다.
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY----------END PUBLIC KEY-----
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY----------END PRIVATE KEY-----

# ===== JWT Refresh Token (RS256) =====
# Access Token과 별도의 RSA 키쌍을 사용합니다.
# 아래 역시 로컬 개발 전용 더미 키이며 운영 환경에 재사용하면 안 됩니다.
JWT_REFRESH_PUBLIC_KEY=-----BEGIN PUBLIC KEY----------END PUBLIC KEY-----
JWT_REFRESH_PRIVATE_KEY=-----BEGIN PRIVATE KEY----------END PRIVATE KEY-----

# ===== 개인정보 암호화 (AES-256-GCM) =====
# 로컬 개발 전용 더미 키. 실제 값은 openssl rand -base64 32 등으로 팀에서 별도 생성.
ENCRYPTION_KEY=local-dev-only-not-for-production-use-0000

# ===== User Service 이메일 보호 (AES-256-GCM + HMAC-SHA256) =====
# 로컬 개발 전용 Base64 32바이트 더미 키. 운영 환경에서는 각각 새로 생성해야 합니다.
EMAIL_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
EMAIL_LOOKUP_HMAC_KEY=ZmVkY2JhOTg3NjU0MzIxMGZlZGNiYTk4NzY1NDMyMTA=

# ===== 서비스 간 HMAC 내부 통신 키 (서비스 쌍별로 값이 같아야 함, 로컬 개발 전용 더미) =====
HMAC_KEY_CONTENT_TO_JUDGE=local-dev-hmac-content-to-judge
HMAC_KEY_COACHING_TO_JUDGE=local-dev-hmac-coaching-to-judge
HMAC_KEY_COACHING_TO_CONTENT=local-dev-hmac-coaching-to-content
HMAC_KEY_CONTENT_TO_COACHING=local-dev-hmac-content-to-coaching

# ===== LLM API =====
# ⚠️ 절대 이 파일(.env.example)에 실제 값을 채워서 커밋하지 마세요 — Public 저장소입니다.
# 각자 로컬 .env(git 추적 안 됨)에만 본인의 개인/팀 키를 넣으세요.
ANTHROPIC_API_KEY=

# 팀 컨벤션상 실제 벤더는 Anthropic(ClaudeModelAdapter)이며, 이게 기본입니다(AI_MODEL_CHAT 비워두면 됨).
# 로컬 개발 중 크레딧 소모 없이 확인해보고 싶으면 AI_MODEL_CHAT=google-genai로 바꾸고
# GEMINI_API_KEY를 채우세요(GeminiModelAdapter). 둘 다 안 채워도 무방합니다.
AI_MODEL_CHAT=
GEMINI_API_KEY=

# ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ===== Judge0 =====
JUDGE0_BASE_URL=http://localhost:2358

# ===== Eureka =====
EUREKA_URL=http://localhost:8761/eureka/

# ===== Grafana Alerting =====
# ⚠️ 이것도 실제 Slack Webhook URL이 생기면 .env.example이 아닌 각자 .env에만 넣으세요.
SLACK_WEBHOOK_URL=
