# ⚠️ 이슈 #310 — Refresh Token 쿠키의 Secure 속성이 평문 HTTP에서 전송 안 되던 문제 해결.
# 도메인이 없어 Let's Encrypt 인증서를 못 받던 상황을, nip.io(EC2 Elastic IP를
# 그대로 가리키는 무료 와일드카드 DNS)로 우회. Caddy가 이 도메인 하나만 보고
# 인증서 발급·갱신을 전부 자동으로 처리한다(별도 인증서 파일 관리 불필요).
#
# ${EC2_ELASTIC_IP}는 실제 배포 시 .env의 EC2_ELASTIC_IP 값으로 치환된다.
# 예: 54.180.36.179 -> 54-180-36-179.nip.io (nip.io는 IP의 점(.)을
# 하이픈(-)으로 바꾼 서브도메인 형식도 지원 — 도메인 자체에 점이 들어가면
# Let's Encrypt가 이를 여러 라벨로 오인할 수 있어 하이픈 형식을 사용한다)

{$EC2_ELASTIC_IP_DASHED}.nip.io {
    # api-gateway는 이제 외부에 직접 노출하지 않고, Caddy를 통해서만 접근한다
    reverse_proxy api-gateway:8080

    # 실제 클라이언트 IP를 Gateway의 Rate Limit(remoteAddress 기반)이
    # 여전히 정확히 볼 수 있도록 표준 헤더를 그대로 전달한다.
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-For {remote_host}
}

# 혹시 HTTP(80)로 직접 오는 요청은 자동으로 HTTPS로 리다이렉트(Caddy 기본 동작,
# 명시적으로 한 번 더 남겨서 의도를 분명히 함)
http://{$EC2_ELASTIC_IP_DASHED}.nip.io {
    redir https://{host}{uri} permanent
}
